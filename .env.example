# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Your production URL (used for SEO, sitemap and Open Graph). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact form email delivery via Resend (https://resend.com). Without a key,
# submissions are logged on the server and the form still shows success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_FROM_EMAIL="MAK Studio <hello@yourdomain.com>"
